{
  "name": "intelligent-api-monitor",
  "version": "1.0.0",
  "description": "Intelligent API Monitoring & Alert System — detects anomalies in API responses and generates AI-powered, human-readable alerts.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "monitor:file": "node src/scripts/monitorFile.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "keywords": [
    "api-monitoring",
    "anomaly-detection",
    "llm",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.3",
    "nodemailer": "^10.2.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
