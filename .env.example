# ---------------------------------------------------------------
# Intelligent API Monitor – environment settings
# Copy to .env and fill in what you need. Everything is optional:
# with no values the app runs with in-memory storage and
# rule-based alert text, so it always starts.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_TO_FILE=false

# --- Database (MongoDB Atlas or local). Empty = in-memory store ---
MONGODB_URI=
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/api_monitor?retryWrites=true&w=majority

# --- AI alert generation -------------------------------------------
# gemini | openai | none   (blank = auto: Gemini key first, then OpenAI)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible API works (Groq, OpenRouter, local LLMs ...)
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_RETRIES=1
# How many anomalies are described per LLM call, and how many calls run in parallel
AI_CHUNK_SIZE=8
AI_CONCURRENCY=3

# --- Detection thresholds (per-API overrides: src/config/apiRules.json) ---
RESPONSE_TIME_WARN_MS=2000
RESPONSE_TIME_CRITICAL_MS=5000
MIN_RECORDS=1
# Statistical baseline: flag latency > mean + N·σ of the API's own recent history
BASELINE_SIGMA=3
BASELINE_MIN_SAMPLES=5
BASELINE_WINDOW=50
BATCH_MAX_ITEMS=1000

# --- Automatic polling of real endpoints (src/config/targets.json) ---
ENABLE_SCHEDULER=false
POLL_INTERVAL_MS=60000
POLL_TIMEOUT_MS=10000

# --- E-mail anomaly reports (optional) ----------------------------
EMAIL_ENABLED=false
EMAIL_ON_CRITICAL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# For Gmail use an App Password, not your normal password
SMTP_PASS=
EMAIL_FROM=API Monitor <your-address@gmail.com>
# Comma-separated list
EMAIL_TO=

# --- Security (optional) ------------------------------------------
# When set, write endpoints (POST /monitor, resolve ...) need header  x-api-key: <value>
MONITOR_API_KEY=
# Public interview demo: allow JSON/sample/simulated monitoring checks without a key.
# These endpoints are rate-limited; alert management, email, and live polling stay protected.
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_MAX_ITEMS=100
# Comma-separated allowed origins for a separately hosted frontend; blank = allow all
CORS_ORIGINS=
